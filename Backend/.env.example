# Application Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Application metadata
APP_NAME="AICTE Security Deposit / FDR Management Portal"
API_VERSION=1.0.0

# Server Binding
HOST=127.0.0.1
PORT=5000

# Security (Change in production!)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Default is SQLite inside instance/ folder.
# For PostgreSQL in staging/production, configure:
# DATABASE_URL=postgresql+psycopg2://aicte_user:secure_password@localhost:5432/aicte_fdr_db
DATABASE_URL=sqlite:///aicte_fdr.db
 
# CORS Configuration for Frontend Development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
